# Vhost do MeshCentral. Renderize com:
#   sed 's/__MESH_DOMAIN__/mesh.jssystem-server.xyz/g' \
#     remote-access/nginx_meshcentral.conf.template \
#     > /etc/nginx/sites-available/meshcentral.conf

# Map próprio para não colidir com o $connection_upgrade já definido no
# vhost do Chatwoot (mesmo http context — redefinir daria "duplicate map").
map $http_upgrade $mesh_connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 80;
  listen [::]:80;
  server_name __MESH_DOMAIN__;

  access_log /var/log/nginx/meshcentral_access_80.log;
  error_log /var/log/nginx/meshcentral_error_80.log;

  location /.well-known/acme-challenge/ {
    root /var/www/html;
  }

  location / {
    return 301 https://__MESH_DOMAIN__$request_uri;
  }
}

server {
  # Sem "reuseport" aqui: já está no vhost do Chatwoot e só pode aparecer
  # uma vez por address:port em todo o nginx.
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name __MESH_DOMAIN__;

  access_log /var/log/nginx/meshcentral_access_443.log;
  error_log /var/log/nginx/meshcentral_error_443.log;

  location / {
    proxy_pass http://127.0.0.1:4430;
    proxy_redirect off;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host:$server_port;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # WebSocket: usado tanto pelo agente (/agent.ashx) quanto pelo stream
    # da área de trabalho no navegador.
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $mesh_connection_upgrade;

    # Buffering desligado: com ele o vídeo da sessão remota engasga.
    proxy_buffering off;

    client_max_body_size 0;
    proxy_send_timeout 3600s;
    proxy_read_timeout 3600s;
  }

  ssl_certificate /etc/letsencrypt/live/__MESH_DOMAIN__/fullchain.pem; # managed by Certbot
  ssl_certificate_key /etc/letsencrypt/live/__MESH_DOMAIN__/privkey.pem; # managed by Certbot
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}
