<% content_for(:title) do %>
  Usage: <%= @account.name %> (#<%= @account.id %>)
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>
  </h1>
  <div class="mt-2">
    <%= link_to '&larr; Back to Account Usage'.html_safe, super_admin_account_usages_path, class: 'text-blue-600 hover:text-blue-800 text-sm font-medium' %>
    &middot;
    <%= link_to 'View Account', super_admin_account_path(@account), class: 'text-blue-600 hover:text-blue-800 text-sm font-medium' %>
  </div>
</header>

<section class="main-content__body">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
    <% usage_items = [
      { label: 'Agents', current: @usage[:agents][:current], limit: @usage[:agents][:limit] },
      { label: 'Inboxes', current: @usage[:inboxes][:current], limit: @usage[:inboxes][:limit] },
      { label: 'Contacts', current: @usage[:contacts][:current] },
      { label: 'Conversations', current: @usage[:conversations][:current] },
      { label: 'Messages', current: @usage[:messages][:current] },
      { label: 'Teams', current: @usage[:teams][:current] },
      { label: 'Labels', current: @usage[:labels][:current] },
      { label: 'Campaigns', current: @usage[:campaigns][:current] },
      { label: 'Automation Rules', current: @usage[:automation_rules][:current] },
      { label: 'Canned Responses', current: @usage[:canned_responses][:current] },
      { label: 'Webhooks', current: @usage[:webhooks][:current] },
    ] %>

    <% usage_items.each do |item| %>
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="text-xs uppercase tracking-wider text-slate-500 font-medium">
          <%= item[:label] %>
        </div>
        <div class="mt-2 text-2xl font-semibold text-slate-900 tabular-nums">
          <%= number_with_delimiter(item[:current]) %>
          <% if item[:limit] %>
            <span class="text-sm font-normal text-slate-400">/ <%= number_with_delimiter(item[:limit]) %></span>
          <% end %>
        </div>
        <% if item[:limit] && item[:limit] > 0 %>
          <% percent = [(item[:current].to_f / item[:limit] * 100).round, 100].min %>
          <div class="mt-3 rounded-full overflow-hidden h-2 w-full bg-slate-100">
            <div class="h-2 rounded-full <%= percent < 50 ? 'bg-teal-500' : percent < 80 ? 'bg-amber-500' : 'bg-red-500' %>" style="width: <%= percent %>%"></div>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs uppercase tracking-wider text-slate-500 font-medium">
        Storage Used
      </div>
      <div class="mt-2 text-2xl font-semibold text-slate-900 tabular-nums">
        <%= number_to_human_size(@usage[:storage_bytes][:current]) %>
      </div>
    </div>
  </div>
</section>
